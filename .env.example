# ---- core ----
JWT_SECRET=put-a-long-random-string-here
ADMIN_EMAIL=admin@arbedge.io
ADMIN_PASSWORD=admin123
CORS_ORIGINS=*

# ---- odds feed ----
# demo       = built-in simulator (works instantly, no key)
# theoddsapi = real odds from the-odds-api.com
# scrapers   = your own scrapers in app/providers/scrapers/
# hybrid     = theoddsapi + scrapers merged
ODDS_PROVIDER=demo
ODDS_API_KEY=
ODDS_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_uefa_champs_league,basketball_nba,icehockey_nhl
ODDS_REGIONS=uk,eu,us,au
ODDS_MARKETS=h2h,totals
ODDS_POLL_SECONDS=60
DEMO_TICK_SECONDS=2.5
